# Copy to `.env` in this folder. Everything is optional.
# The database credentials themselves are NOT here: they are read from the
# file named by `envFile` in sources.yaml (~/projects/.env.mongo).

# Model (Ollama). `none` runs rules only: no asks, no model notes.
AGENT_MODEL=qwen2.5-coder:3b
OLLAMA_HOST=http://127.0.0.1:11434

# Server
AGENT_PORT=47821
AGENT_HOST=127.0.0.1
# AGENT_TOKEN=            # required if AGENT_HOST is not loopback

# --- Reaching the database ---------------------------------------------------
# Full connection string, e.g. the local docker copy (no credentials needed):
# AGENT_MONGO_URI=mongodb://127.0.0.1:27017/
# AGENT_MONGO_DATABASE=devlms     # needed only if the URI has no database in it
#   (when AGENT_MONGO_URI is set, ~/projects/.env.mongo is not opened at all)
# or keep the env file's credentials and change only how to reach the host,
# e.g. through an SSH tunnel on a local port:
# AGENT_MONGO_HOST_OVERRIDE=127.0.0.1:27018
# AGENT_MONGO_DIRECT=true
# AWS DocumentDB needs TLS and its CA bundle:
# AGENT_MONGO_TLS=true
# AGENT_MONGO_TLS_CA_FILE=~/projects/global-bundle.pem
# AGENT_MONGO_REPLICA_SET=rs0
# AGENT_MONGO_AUTH_SOURCE=admin
